   "source": [
    "# URL of the GeoJSON\n",
    "url = \"https://urbanobservatory.ac.uk/cache/geojson/livesensors.json\"\n",
    "data = requests.get(url).json()\n",
    "\n",
    "# Transformer: EPSG 3857 → EPSG 4326 (lon, lat)\n",
    "transformer = Transformer.from_crs(\"EPSG:3857\", \"EPSG:4326\", always_xy=True)\n",
    "\n",
    "rows = []\n",
    "for feat in data[\"features\"]:\n",
    "    x, y = feat[\"geometry\"][\"coordinates\"]\n",
    "    props = feat[\"properties\"]\n",
    "\n",
    "    # Convert to lon/lat\n",
    "    lon, lat = transformer.transform(x, y)\n",
    "\n",
    "    rows.append({\n",
    "        \"sensor_id\": props.get(\"id\") or props.get(\"sensor_id\"),\n",
    "        \"x_webmerc\": x,\n",
    "        \"y_webmerc\": y,\n",
    "        \"lon\": lon,\n",
    "        \"lat\": lat\n",
    "    })\n",
    "\n",
    "df = pd.DataFrame(rows, columns=[\"sensor_id\", \"lon\", \"lat\"])\n",
    "\n",
    "csv_file_name = f\"sensor_coordinates.csv\" # file name\n",
    "\n",
    "data = df\n",
    "\n",
    "data.to_csv(f\"./csv_extraction/{csv_file_name}\") # folder name\n",
    "\n",
    "print(df)"
   ]
  },
